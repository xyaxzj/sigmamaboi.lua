    local function getCleanBaseName(rawName)
        if not rawName then return "" end
        local n = tostring(rawName)
        n = string.gsub(n, "%s*%[.-%]", "")
        n = string.gsub(n, "%s*%(.-%)", "")
        n = string.match(n, "^%s*(.-)%s*$") or n
        return n
    end

    local function matchMaterialCraft(rawName)
        if not rawName then return nil end
        local clean = string.lower(getCleanBaseName(rawName))
        for _, mat in ipairs(MATERIAL_CRAFT_ITEMS) do
            if clean == string.lower(mat) then
                return mat
            end
        end
        -- Aliases & smart fallback for variations
        if string.find(clean, "cucumbro", 1, true) and string.find(clean, "nerdino", 1, true) then
            return "Cucumbro Nerdino"
        end
        if string.find(clean, "stoppo", 1, true) and string.find(clean, "luminino", 1, true) then
            return "Stoppo Luminino"
        end
        if (string.find(clean, "peant", 1, true) or string.find(clean, "peanut", 1, true)) and string.find(clean, "jarro", 1, true) then
            return "Peant Jarro"
        end
        if string.find(clean, "burguro", 1, true) then
            return "Burguro"
        end
        if string.find(clean, "karkerkar", 1, true) or string.find(clean, "kurkur", 1, true) then
            return "Karkerkar Kurkur"
        end
        if string.find(clean, "swag", 1, true) and string.find(clean, "soda", 1, true) then
            return "SWAG SODA"
        end
        if string.find(clean, "penneroni", 1, true) then
            return "Professor Penneroni"
        end
        if string.find(clean, "hostpot", 1, true) or string.find(clean, "hotspot", 1, true) then
            return "Pot Hostpot"
        end
        return nil
    end

