        for _, attr in ipairs({"Favorite", "favorite", "Fav", "fav", "Favorited", "favorited", "IsFavorite", "isFavorite", "IsFav", "isFav"}) do
            local val = tool:GetAttribute(attr)
            if val ~= nil then
