            local obj = tool:FindFirstChild(name)
            if obj and (obj:IsA("BoolValue") or obj:IsA("IntValue") or obj:IsA("ValueBase")) then
                return (obj.Value == true or obj.Value == 1 or obj.Value == "true")
            end
        end
        return false
    end

