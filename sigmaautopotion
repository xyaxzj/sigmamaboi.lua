    -- ══════════════════════════════════════════
    -- INVENTORY SYNC ENGINE
    -- ══════════════════════════════════════════
    refreshInventoryText = function()
        if not CachedInventoryData then return end
        
        local craftFilterOpt = "🔨 All Material Craft (Merged Qty)"
        if InvMaterialCraftDropdown then
            pcall(function()
                craftFilterOpt = InvMaterialCraftDropdown:Get() or "🔨 All Material Craft (Merged Qty)"
            end)
        end

        local selectedRarities = {}
        if InvRarityDropdown then
            pcall(function()
                selectedRarities = InvRarityDropdown:Get()
                if type(selectedRarities) ~= "table" then selectedRarities = {selectedRarities} end
            end)
        end
        
        local selectedMutations = {}
        if InvMutationDropdown then
            pcall(function()
                selectedMutations = InvMutationDropdown:Get()
                if type(selectedMutations) ~= "table" then selectedMutations = {selectedMutations} end
            end)
        end
        
        local favFilterOpt = "All Items"
        if InvFavFilterDropdown then
            pcall(function()
                favFilterOpt = InvFavFilterDropdown:Get() or "All Items"
            end)
        end

        local lvlFilterOpt = "All Levels"
        if InvLevelFilterDropdown then
            pcall(function()
                lvlFilterOpt = InvLevelFilterDropdown:Get() or "All Levels"
            end)
        end
        
        local hasRarityFilter = false
        for _, r in pairs(selectedRarities) do
            if r ~= "" then hasRarityFilter = true; break end
        end
        
        local hasMutationFilter = false
        for _, m in pairs(selectedMutations) do
            local cleanM = getBaseName(m)
            if cleanM ~= "" then hasMutationFilter = true; break end
        end
        
        local hasFavFilter = (favFilterOpt ~= "All Items")
        local hasLvlFilter = (lvlFilterOpt ~= "All Levels")
        local isFiltered = hasRarityFilter or hasMutationFilter or hasFavFilter or hasLvlFilter
        
        local categorizedItems = {}
        local categoryTotals = {}
        local filteredTotalCount = 0
        
        local InfiniteMath
        pcall(function()
            local Shared = ReplicatedStorage:FindFirstChild("Shared")
            local Utility = Shared and Shared:FindFirstChild("Utility")
            local IMObj = Utility and Utility:FindFirstChild("InfiniteMath")
            if IMObj then InfiniteMath = require(IMObj) end
        end)
        
        local totalCPSVal = InfiniteMath and InfiniteMath.new(0) or 0
        local filteredCPSVal = InfiniteMath and InfiniteMath.new(0) or 0
        
        local itemFilterPassed = {}
        local itemCPSMap = {}
        local itemFavMap = {}
        local itemLevelMap = {}
        local itemRarityMap = {}
        local itemMutationMap = {}
        local totalFavCount = 0
        
        local craftCounts = {}
        local craftFavCounts = {}
        for _, mat in ipairs(MATERIAL_CRAFT_ITEMS) do
            craftCounts[mat] = 0
            craftFavCounts[mat] = 0
        end

        -- Pass 1: Scan tools sekali dan cache ke map
        for _, tool in ipairs(getAllTools()) do
            if isTradeable(tool) then
                local fullName = getFullItemName(tool)
                local toolCPS = getToolCPS(tool)
                local toolLvl = getToolLevel(tool)
                local toolRarity = getItemInfo(tool)
                local toolMutation = getToolMutation(tool)
                local isFav = isToolFavorite(tool)

                itemLevelMap[fullName] = toolLvl
                itemRarityMap[fullName] = toolRarity
                itemMutationMap[fullName] = toolMutation

                if toolCPS then
                    pcall(function()
                        totalCPSVal = totalCPSVal + toolCPS
                    end)
                    itemCPSMap[fullName] = toolCPS
                end
                if isFav then
                    itemFavMap[fullName] = true
                    totalFavCount = totalFavCount + 1
                end

                local matName = matchMaterialCraft(tool.Name) or matchMaterialCraft(fullName)
                if matName then
                    craftCounts[matName] = (craftCounts[matName] or 0) + 1
                    if isFav then
                        craftFavCounts[matName] = (craftFavCounts[matName] or 0) + 1
                    end
                end
            end
        end
        CachedFavoriteCount = totalFavCount

        -- ══════════════════════════════════════════
        -- MATERIAL CRAFT VIEW (CONSOLIDATED / JUST QTY)
        -- ══════════════════════════════════════════
        if craftFilterOpt ~= "All Items (Normal)" then
            local isAllCraft = (craftFilterOpt == "🔨 All Material Craft (Merged Qty)")
            local targetItems = isAllCraft and MATERIAL_CRAFT_ITEMS or { craftFilterOpt }
            
            local totalTargetQty = 0
            for _, mat in ipairs(targetItems) do
                local q = craftCounts[mat] or 0
                if favFilterOpt == "⭐ Only Favorites" then
                    q = craftFavCounts[mat] or 0
                elseif favFilterOpt == "⚪ Only Non-Favorites" then
                    q = math.max(0, (craftCounts[mat] or 0) - (craftFavCounts[mat] or 0))
                end
                totalTargetQty = totalTargetQty + q
            end

            -- Update Overview Statistics Label
            local overviewText = string.format("📦 Total Stock: %d items  │  ⭐ Favorites: %d items\n🔨 Material Craft: %d items (Consolidated)",
                CachedTotalCount, CachedFavoriteCount, totalTargetQty)
            if favFilterOpt ~= "All Items" then
                overviewText = overviewText .. "  │  " .. favFilterOpt
            end
            if OverviewLabel then
                OverviewLabel:Set("Inventory Overview", overviewText)
            end

            -- Update Minimized status in Sigma UI
            pcall(function()
                Window:SetMinimizedText(string.format("🔨 Craft: %d Items", totalTargetQty))
                Window:SetMinimizedGlow("Success")
            end)

            -- Build Formatted Item List (Just pure quantity per name, no mutations, all merged)
            local displayString = "🔨 MATERIAL CRAFT (CONSOLIDATED / JUST QTY)\n"
            if isAllCraft then
                displayString = displayString .. string.format("Filter: All 8 Craft Materials  │  Total Qty: %d\n", totalTargetQty)
            else
                displayString = displayString .. string.format("Filter: %s  │  Total Qty: %d\n", craftFilterOpt, totalTargetQty)
            end
            if favFilterOpt ~= "All Items" then
                displayString = displayString .. "Status Filter: " .. favFilterOpt .. "\n"
            end
            displayString = displayString .. "\n"

            for _, mat in ipairs(targetItems) do
                local q = craftCounts[mat] or 0
                if favFilterOpt == "⭐ Only Favorites" then
                    q = craftFavCounts[mat] or 0
                elseif favFilterOpt == "⚪ Only Non-Favorites" then
                    q = math.max(0, (craftCounts[mat] or 0) - (craftFavCounts[mat] or 0))
                end
                displayString = displayString .. string.format(" • %s: %dx\n", mat, q)
            end

            LastFormattedInventoryText = displayString
            if FullInventoryLabel then
                FullInventoryLabel:Set("Item List & Total", displayString)
            end

            task.defer(fixAllSectionHeights)
            return
        end
        
        -- Pass 2: Filter dan kategorikan item
        for itemName, amount in pairs(CachedInventoryData) do
            local itemRarity = itemRarityMap[itemName] or "Unknown"
            local itemMutation = itemMutationMap[itemName]
            local itemLvl = itemLevelMap[itemName] or 1
            local filterMut = itemMutation or "No Mutation"
            local isFav = itemFavMap[itemName] == true
            
            -- Rarity filter
            local rarityPass = true
            if hasRarityFilter then
                local found = false
                for _, r in pairs(selectedRarities) do
                    if r == itemRarity then found = true; break end
                end
                if not found then rarityPass = false end
            end
            
            -- Mutation filter
            local mutationPass = true
            if hasMutationFilter then
                local found = false
                for _, m in pairs(selectedMutations) do
                    local cleanM = getBaseName(m)
                    if cleanM == filterMut then found = true; break end
                end
                if not found then mutationPass = false end
            end

            -- Favorite filter
            local favPass = true
            if favFilterOpt == "⭐ Only Favorites" then
                favPass = isFav
            elseif favFilterOpt == "⚪ Only Non-Favorites" then
                favPass = not isFav
            end

            -- Level filter
            local lvlPass = true
            if lvlFilterOpt == "Lv. 1 Only" then
                lvlPass = (itemLvl == 1)
            elseif lvlFilterOpt == "Lv. > 1 (Upgraded)" then
                lvlPass = (itemLvl > 1)
            elseif lvlFilterOpt == "Max Level Only" then
                lvlPass = (itemLvl >= 100 or string.find(string.lower(itemName), "max"))
            end
            
            if rarityPass and mutationPass and favPass and lvlPass then
                itemFilterPassed[itemName] = true
                local category = "🏆 " .. string.upper(itemRarity) .. (itemMutation and (" " .. string.upper(itemMutation)) or "") .. " ITEMS"
                if not categorizedItems[category] then
                    categorizedItems[category] = {}
                    categoryTotals[category] = 0
                end
                
                local itemCPS = itemCPSMap[itemName]
                table.insert(categorizedItems[category], {
                    name = itemName, 
                    qty = amount, 
                    rarity = itemRarity, 
                    cps = itemCPS,
                    isFav = isFav
                })
                categoryTotals[category] = categoryTotals[category] + amount
                filteredTotalCount = filteredTotalCount + amount
            end
        end
        
        -- Pass 3: Hitung filtered CPS
        for _, tool in ipairs(getAllTools()) do
            if isTradeable(tool) then
                local fullName = getFullItemName(tool)
                if itemFilterPassed[fullName] then
                    local toolCPS = itemCPSMap[fullName]
                    if toolCPS then
                        pcall(function()
                            filteredCPSVal = filteredCPSVal + toolCPS
                        end)
                    end
                end
            end
        end
        
        local totalCpsStr = tostring(totalCPSVal)
        local filteredCpsStr = tostring(filteredCPSVal)
        
        -- Update Overview Statistics Label
        local overviewText = string.format("📦 Total Stock: %d items  │  ⭐ Favorites: %d items\n🧬 Unique Variants: %d items  │  ⚡ Total CPS: %s",
            CachedTotalCount, CachedFavoriteCount, CachedUniqueCount, totalCpsStr)
        if isFiltered then
            overviewText = overviewText .. string.format("\n🎯 Showing: %d / %d (Filtered)  │  ⚡ Filtered CPS: %s",
                filteredTotalCount, CachedTotalCount, filteredCpsStr)
        end
        if OverviewLabel then
            OverviewLabel:Set("Inventory Overview", overviewText)
        end

        -- Update Minimized status in Sigma UI
        pcall(function()
            Window:SetMinimizedText(string.format("%d Items | ⭐ %d", CachedTotalCount, CachedFavoriteCount))
            Window:SetMinimizedGlow("Success")
        end)

        -- Build Formatted Item List
        local displayString = ""
        if isFiltered then
            displayString = string.format("Showing %d / %d Items (Filtered)  │  ⭐ %d Favorites\n", filteredTotalCount, CachedTotalCount, CachedFavoriteCount)
            displayString = displayString .. "Filtered CPS: " .. filteredCpsStr .. "  │  Total CPS: " .. totalCpsStr .. "\n\n"
            if filteredTotalCount == 0 then
                displayString = displayString .. "No items match the selected filters."
            end
        else
            displayString = string.format("Total All Items: %d (⭐ %d Favorites)\n", CachedTotalCount, CachedFavoriteCount)
            displayString = displayString .. "Total CPS: " .. totalCpsStr .. "\n\n"
            if CachedTotalCount == 0 then
                displayString = displayString .. "Inventory is completely empty."
            end
        end
        
        if filteredTotalCount > 0 then
            local sortedCategories = {}
            for cat, _ in pairs(categorizedItems) do table.insert(sortedCategories, cat) end
            table.sort(sortedCategories)
            for _, cat in ipairs(sortedCategories) do
                displayString = displayString .. "=== " .. cat .. " (Total: " .. categoryTotals[cat] .. ") ===\n"
                table.sort(categorizedItems[cat], function(x, y)
                    local a = x.cps
                    local b = y.cps
                    local typeA = typeof(a)
                    local typeB = typeof(b)
                    if typeA == typeB then
                        if typeA == "nil" then
                            return x.name < y.name
                        end
                        if a == b then
                            return x.name < y.name
                        end
                        return a > b
                    elseif typeA == "table" or typeA == "userdata" then
                        return true
                    elseif typeB == "table" or typeB == "userdata" then
                        return false
                    else
                        if a ~= nil and b == nil then
                            return true
                        elseif a == nil and b ~= nil then
                            return false
                        else
                            return x.name < y.name
                        end
                    end
                end)
                for _, item in ipairs(categorizedItems[cat]) do 
                    local cpsStr = item.cps and (" │ CPS: " .. tostring(item.cps)) or ""
                    local favPrefix = item.isFav and "⭐ " or ""
                    displayString = displayString .. string.format(" • %s%s (Stock: %d%s)\n", favPrefix, item.name, item.qty, cpsStr) 
                end
                displayString = displayString .. "\n"
            end
        end
        
        LastFormattedInventoryText = displayString
        if FullInventoryLabel then
            FullInventoryLabel:Set("Item List & Total", displayString)
        end

        -- Pastikan semua section terbuka dan tidak terpotong
        task.defer(fixAllSectionHeights)
    end

    updateInventoryDisplay = function()
        if isSyncingUI then return end
        isSyncingUI = true
        task.spawn(function()
            task.wait(0.3) 
            local inventoryData = {}; local totalCount = 0; local uniqueCount = 0
            for _, tool in pairs(getAllTools()) do  
                if isTradeable(tool) then
                    local displayName = getFullItemName(tool)  
                    if not inventoryData[displayName] then
                        uniqueCount = uniqueCount + 1
                    end
                    inventoryData[displayName] = (inventoryData[displayName] or 0) + 1  
                    totalCount = totalCount + 1  
                end
            end  
            CachedInventoryData = inventoryData
            CachedTotalCount = totalCount
            CachedUniqueCount = uniqueCount
            
            local invMutList = getInventoryMutationList()
            if InvMutationDropdown then
                pcall(function() InvMutationDropdown:Refresh(invMutList) end)
            end
            
            refreshInventoryText()
            isSyncingUI = false 
        end)
    end

    -- ══════════════════════════════════════════
    -- REAL-TIME INVENTORY EVENT LISTENERS
    -- ══════════════════════════════════════════
    local function connectInventory()
        for _, conn in ipairs(InventoryConnections) do
            pcall(function() conn:Disconnect() end)
        end
        table.clear(InventoryConnections)

        local backpack = localPlayer:WaitForChild("Backpack", 5)
        if backpack then
            table.insert(InventoryConnections, backpack.ChildAdded:Connect(function(child)
                if child:IsA("Tool") then updateInventoryDisplay() end
            end))
            table.insert(InventoryConnections, backpack.ChildRemoved:Connect(function(child)
                if child:IsA("Tool") then updateInventoryDisplay() end
            end))
        end

        local function hookCharacter(char)
            if not char then return end
            table.insert(InventoryConnections, char.ChildAdded:Connect(function(child)
                if child:IsA("Tool") then updateInventoryDisplay() end
            end))
            table.insert(InventoryConnections, char.ChildRemoved:Connect(function(child)
                if child:IsA("Tool") then updateInventoryDisplay() end
            end))
        end

        if localPlayer.Character then
            hookCharacter(localPlayer.Character)
        end
        table.insert(InventoryConnections, localPlayer.CharacterAdded:Connect(function(char)
            hookCharacter(char)
            task.wait(1)
            updateInventoryDisplay()
        end))
    end

    -- Connect listeners and perform initial scan
    connectInventory()
    updateInventoryDisplay()

    -- Post-launch: perbaiki tinggi semua section setelah jendela selesai animasi buka
    task.delay(0.6, fixAllSectionHeights)
    task.delay(1.2, fixAllSectionHeights)

    notifyUser("Inventory Viewer", "Loaded successfully! 2 Tabs active (Inventory & Event).", 3, "Success")

end)

if not success then
    warn("[Inventory Viewer Error]:", errorMessage)
end
