    -- Memaksa frame paragraf dan section mengembang secara presisi di mobile/PC
    local function applyDynamicParagraph(rawParaObj, sectionTitle)
        local foundPFrame = nil
        local foundPDesc = nil
        local foundPTitle = nil

        -- Cari PFrame di dalam ScreenGui
        pcall(function()
            local sg = game:GetService("CoreGui"):FindFirstChild("SigmaUI") or (gethui and gethui():FindFirstChild("SigmaUI")) or localPlayer.PlayerGui:FindFirstChild("SigmaUI")
            if sg then
                for _, desc in ipairs(sg:GetDescendants()) do
                    if desc:IsA("TextLabel") and desc.Text == sectionTitle then
                        foundPTitle = desc
                        foundPFrame = desc.Parent
                        for _, child in ipairs(foundPFrame:GetChildren()) do
                            if child:IsA("TextLabel") and child ~= desc then
                                foundPDesc = child
                                break
                            end
                        end
                        break
                    end
                end
            end
        end)

        return {
            Set = function(_, newTitle, newContent)
                pcall(function()
                    rawParaObj:Set(newTitle, newContent)
                end)
                
                -- Jika frame belum tercari, coba cari lagi
                if not foundPFrame then
                    pcall(function()
                        local sg = game:GetService("CoreGui"):FindFirstChild("SigmaUI") or (gethui and gethui():FindFirstChild("SigmaUI")) or localPlayer.PlayerGui:FindFirstChild("SigmaUI")
                        if sg then
                            for _, desc in ipairs(sg:GetDescendants()) do
                                if desc:IsA("TextLabel") and desc.Text == newTitle then
                                    foundPTitle = desc
                                    foundPFrame = desc.Parent
                                    for _, child in ipairs(foundPFrame:GetChildren()) do
                                        if child:IsA("TextLabel") and child ~= desc then
                                            foundPDesc = child
                                            break
                                        end
                                    end
                                    break
                                end
                            end
                        end
                    end)
                end

                if foundPFrame and foundPDesc then
                    pcall(function()
                        foundPFrame.AutomaticSize = Enum.AutomaticSize.Y
                        foundPDesc.AutomaticSize = Enum.AutomaticSize.Y
                        foundPDesc.TextWrapped = true

                        -- Hitung tinggi eksak teks menggunakan TextService
                        local width = math.max(300, foundPFrame.AbsoluteSize.X - 24)
                        local sz = TextService:GetTextSize(
                            tostring(newContent),
                            foundPDesc.TextSize or 11,
                            foundPDesc.Font or Enum.Font.Gotham,
                            Vector2.new(width, 1000000)
                        )
                        local targetH = math.max(48, sz.Y + 36)
                        foundPFrame.Size = UDim2.new(1, 0, 0, targetH)

                        -- Update SecFrame induk agar tidak terpotong ClipsDescendants
                        local inner = foundPFrame.Parent
                        local secFrame = inner and inner.Parent
                        if secFrame and secFrame:IsA("Frame") then
                            local innerLayout = inner:FindFirstChildOfClass("UIListLayout")
                            local layoutH = innerLayout and innerLayout.AbsoluteContentSize.Y or targetH
                            local secH = math.max(layoutH + 46, targetH + 46)
                            secFrame.Size = UDim2.new(1, -18, 0, secH)
                        end
                    end)
                end
            end
        }
    end

