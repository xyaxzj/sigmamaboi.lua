end

-- Helper key counter
local function tool_keys(t)
    local k = {}
    if type(t) == "table" then
        for key in pairs(t) do table.insert(k, key) end
    end
    return k
end

-- Helper Inspeksi Mendalam Tool & Konfigurasinya
local function inspectTool(tool)
    if not tool or not tool:IsA("Tool") then
        return nil, "Tidak ada Tool yang dipilih atau dipegang!"
    end
    
    local dump = {
        ToolInfo = {
            Name = tool.Name,
            ClassName = tool.ClassName,
            ToolTip = tool.ToolTip,
            Parent = tool.Parent and tool.Parent.Name or "None",
            CanBeDropped = tool.CanBeDropped,
            RequiresHandle = tool.RequiresHandle
        },
        Attributes = {},
        Configuration = {},
        Values = {},
        ModuleConfigs = {},
        Children = {}
    }
    
    -- 1. Attributes langsung pada Tool
    local attrs = tool:GetAttributes()
    for k, v in pairs(attrs) do
        dump.Attributes[k] = v
    end
    
    -- 2. Configuration & ValueBase Object Descendants
    for _, desc in ipairs(tool:GetDescendants()) do
        if desc:IsA("Configuration") or desc.Name == "Configuration" or desc.Name == "Config" or desc.Name == "Settings" then
            local configAttrs = desc:GetAttributes()
            for k, v in pairs(configAttrs) do
                dump.Configuration[desc.Name .. "." .. k] = v
            end
        end
        
        if desc:IsA("ValueBase") then
            local valName = desc.Name
            local val = desc.Value
            local pName = desc.Parent and desc.Parent.Name or "Root"
            dump.Values[pName .. "/" .. valName] = val
        end
        
        if desc:IsA("ModuleScript") then
            local ok, modData = pcall(require, desc)
            if ok and type(modData) == "table" then
                dump.ModuleConfigs[desc.Name] = modData
            end
        end
        
        if desc.Parent == tool then
            local extraInfo = nil
            if desc:IsA("Animation") then
                extraInfo = "AnimationId: " .. tostring(desc.AnimationId)
            elseif desc:IsA("Sound") then
                extraInfo = "SoundId: " .. tostring(desc.SoundId)
            end
            table.insert(dump.Children, {
                Name = desc.Name,
                ClassName = desc.ClassName,
                Info = extraInfo
            })
        end
    end
    
    return dump
end

