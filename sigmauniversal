local function removeESP(player)
    local espObjects = ESP.Players[player]
    if espObjects then
        pcall(function() espObjects.Box:Destroy() end)
        pcall(function() if espObjects.BoxOutline then espObjects.BoxOutline:Destroy() end end)
        pcall(function() espObjects.NameTag:Destroy() end)
        pcall(function() espObjects.Tracer:Destroy() end)
        pcall(function() if espObjects.TracerOutline then espObjects.TracerOutline:Destroy() end end)
        pcall(function() if espObjects.HealthOutline then espObjects.HealthOutline:Destroy() end end)
        pcall(function() if espObjects.HealthFill then espObjects.HealthFill:Destroy() end end)
        pcall(function() if espObjects.HeadDot then espObjects.HeadDot:Destroy() end end)
        pcall(function() if espObjects.LookTracer then espObjects.LookTracer:Destroy() end end)
        pcall(function() if espObjects.Arrow then espObjects.Arrow:Destroy() end end)
        pcall(function() if espObjects.WeaponTag then espObjects.WeaponTag:Destroy() end end)
        pcall(function() if espObjects.RadarDot then espObjects.RadarDot:Destroy() end end)
        pcall(function()
            if espObjects.Bones then
                for _, line in ipairs(espObjects.Bones) do
                    line:Destroy()
                end
            end
        end)
        pcall(function()
            if espObjects.Corners then
                for _, line in ipairs(espObjects.Corners) do
                    line:Destroy()
                end
            end
        end)
        pcall(function()
            if espObjects.Highlight then
                espObjects.Highlight:Destroy()
            end
        end)
        ESP.Players[player] = nil
    end
end

local function hideESP(objects)
    objects.Box.Visible = false
    if objects.BoxOutline then objects.BoxOutline.Visible = false end
    objects.NameTag.Visible = false
    objects.Tracer.Visible = false
    if objects.TracerOutline then objects.TracerOutline.Visible = false end
    if objects.HealthOutline then objects.HealthOutline.Visible = false end
    if objects.HealthFill then objects.HealthFill.Visible = false end
    if objects.HeadDot then objects.HeadDot.Visible = false end
    if objects.LookTracer then objects.LookTracer.Visible = false end
    if objects.Arrow then objects.Arrow.Visible = false end
    if objects.WeaponTag then objects.WeaponTag.Visible = false end
    if objects.RadarDot then objects.RadarDot.Visible = false end
    if objects.Bones then
        for _, line in ipairs(objects.Bones) do
            line.Visible = false
        end
    end
    if objects.Corners then
        for _, line in ipairs(objects.Corners) do
            line.Visible = false
        end
    end
    if objects.Highlight then
        pcall(function() objects.Highlight.Enabled = false end)
    end
end

