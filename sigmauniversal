local ToolStatusPara = SecToolInspect:AddParagraph("Status Tool Terpilih", "Pegang tool di tangan atau pilih dari dropdown di bawah...")
local ToolAttrPara = SecToolInspect:AddParagraph("Daftar Attributes Terdeteksi", "Belum ada data attributes...")
local ToolConfigPara = SecToolInspect:AddParagraph("Daftar Configuration & Values", "Belum ada data configuration...")

local function refreshToolInspection()
    local held = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
    local targetTool = selectedTool or held
    
    if targetTool and targetTool.Parent then
        local dump = inspectTool(targetTool)
        if dump then
            -- Status Info
            local statusStr = string.format("Nama Tool: %s\nLokasi: %s\nAttributes: %d Terdeteksi\nConfiguration: %d Terdeteksi\nValues: %d Terdeteksi\nChildren: %d Objek",
                targetTool.Name,
                targetTool.Parent and targetTool.Parent.Name or "Unknown",
                #tool_keys(dump.Attributes),
                #tool_keys(dump.Configuration),
                #tool_keys(dump.Values),
                #dump.Children
            )
            ToolStatusPara:Set("Status Tool Terpilih", statusStr)
            
            -- Attributes Preview
            local attrLines = {}
            for k, v in pairs(dump.Attributes) do
                table.insert(attrLines, string.format("• %s = %s (%s)", tostring(k), tostring(v), typeof(v)))
            end
            table.sort(attrLines)
            ToolAttrPara:Set("Daftar Attributes Terdeteksi", #attrLines > 0 and table.concat(attrLines, "\n") or "Tidak ada Attributes pada Tool ini.")
            
            -- Config & Values Preview
            local cfgLines = {}
            for k, v in pairs(dump.Configuration) do
                table.insert(cfgLines, string.format("• [Config] %s = %s", tostring(k), tostring(v)))
            end
            for k, v in pairs(dump.Values) do
                table.insert(cfgLines, string.format("• [Value] %s = %s", tostring(k), tostring(v)))
            end
            table.sort(cfgLines)
            ToolConfigPara:Set("Daftar Configuration & Values", #cfgLines > 0 and table.concat(cfgLines, "\n") or "Tidak ada folder Configuration / ValueBase pada Tool ini.")
        end
    else
        ToolStatusPara:Set("Status Tool Terpilih", "Tidak ada Tool yang sedang dipegang di tangan!")
        ToolAttrPara:Set("Daftar Attributes Terdeteksi", "Pegang sebuah Tool di karakter Anda lalu tekan Refresh.")
        ToolConfigPara:Set("Daftar Configuration & Values", "-")
    end
end

