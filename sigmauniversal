local renderConn = RunService.RenderStepped:Connect(function()
    if not ESP.Enabled then
        for _, objects in pairs(ESP.Players) do
            hideESP(objects)
        end
        pcall(function()
            getgenv().UniversalESPSystem.RadarBackground.Visible = false
            getgenv().UniversalESPSystem.RadarBorder.Visible = false
            getgenv().UniversalESPSystem.RadarLineH.Visible = false
            getgenv().UniversalESPSystem.RadarLineV.Visible = false
            getgenv().UniversalESPSystem.RadarPointer.Visible = false
        end)
        return
    end
    
    local camera = workspace.CurrentCamera
    local viewportSize = camera.ViewportSize
    
    local localChar = LocalPlayer.Character
    local localHrp = localChar and (localChar:FindFirstChild("HumanoidRootPart") or localChar:FindFirstChild("Torso") or localChar:FindFirstChild("UpperTorso") or localChar:FindFirstChildOfClass("BasePart"))
    
    if ESP.RadarEnabled and localHrp then
        createRadar()
        
        local center = Vector2.new(ESP.RadarX, ESP.RadarY)
        local radius = ESP.RadarSize / 2
        
        local bg = getgenv().UniversalESPSystem.RadarBackground
        local border = getgenv().UniversalESPSystem.RadarBorder
        local lineH = getgenv().UniversalESPSystem.RadarLineH
        local lineV = getgenv().UniversalESPSystem.RadarLineV
        local pointer = getgenv().UniversalESPSystem.RadarPointer
        
        if bg and border and lineH and lineV and pointer then
            bg.Position = center
            bg.Radius = radius
            bg.Color = ESP.RadarBgColor
            bg.Visible = true
            
            border.Position = center
            border.Radius = radius
            border.Color = ESP.RadarBorderColor
            border.Visible = true
            
            lineH.From = center - Vector2.new(radius, 0)
            lineH.To = center + Vector2.new(radius, 0)
            lineH.Visible = true
            
            lineV.From = center - Vector2.new(0, radius)
            lineV.To = center + Vector2.new(0, radius)
            lineV.Visible = true
            
            pointer.Position = center
            pointer.Visible = true
        end
    else
        pcall(function()
            getgenv().UniversalESPSystem.RadarBackground.Visible = false
            getgenv().UniversalESPSystem.RadarBorder.Visible = false
            getgenv().UniversalESPSystem.RadarLineH.Visible = false
            getgenv().UniversalESPSystem.RadarLineV.Visible = false
            getgenv().UniversalESPSystem.RadarPointer.Visible = false
        end)
    end
    
    for player, objects in pairs(ESP.Players) do
        local char = player.Character
        local hrp = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso") or char:FindFirstChildOfClass("BasePart"))
        local hum = char and (char:FindFirstChildOfClass("Humanoid") or char:FindFirstChild("AnimationController"))
        
        local positionToUse = nil
        local isStreamedOut = false
        local lastSeenDiff = 0
        
        if hrp then
            positionToUse = hrp.Position
            objects.LastPosition = positionToUse
            objects.LastSeenTime = tick()
        elseif objects.LastPosition then
            positionToUse = objects.LastPosition
            isStreamedOut = true
            lastSeenDiff = math.floor(tick() - (objects.LastSeenTime or tick()))
        end
        
        if positionToUse then
            local dist = math.floor((positionToUse - camera.CFrame.Position).Magnitude)
            
            -- Hide if beyond max distance filter or lost for too long (60 seconds)
            if dist > ESP.MaxDistance or (isStreamedOut and lastSeenDiff > 60) then
                hideESP(objects)
                continue
            end
            
            local health = (not isStreamedOut and hum) and hum.Health or 100
            local maxHealth = (not isStreamedOut and hum) and hum.MaxHealth or 100
            
            if health > 0 then
                local isTeammate = player.Team == LocalPlayer.Team
                
                -- Radar Dot rendering
                if ESP.RadarEnabled and localHrp then
                    local relativePos = localHrp.CFrame:PointToObjectSpace(positionToUse)
                    local dx = relativePos.X * ESP.RadarZoom
                    local dz = relativePos.Z * ESP.RadarZoom
                    
                    local center = Vector2.new(ESP.RadarX, ESP.RadarY)
                    local radius = ESP.RadarSize / 2
                    local distance = math.sqrt(dx^2 + dz^2)
                    
                    local dotColor = ESP.BoxColor
                    if isStreamedOut then
                        dotColor = Color3.fromRGB(120, 120, 120) -- faded grey
                    elseif ESP.UseTeamColor and player.TeamColor then
                        dotColor = player.TeamColor.Color
                    elseif ESP.TeamCheck then
                        dotColor = isTeammate and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 0, 0)
                    end
                    
                    if distance <= radius then
                        objects.RadarDot.Position = center + Vector2.new(dx, dz)
                        objects.RadarDot.Color = dotColor
                        objects.RadarDot.Visible = true
                    else
                        objects.RadarDot.Visible = false
                    end
                else
                    objects.RadarDot.Visible = false
                end
                
                local pos, onScreen = camera:WorldToViewportPoint(positionToUse)
                
                -- Team check
                if ESP.TeamCheck and isTeammate and ESP.HideTeammates then
                    hideESP(objects)
                    continue
                end
                
                -- Decide Color
                local espColor = ESP.BoxColor
                if isStreamedOut then
                    espColor = Color3.fromRGB(120, 120, 120) -- faded grey for streamed-out
                elseif ESP.UseTeamColor and player.TeamColor then
                    espColor = player.TeamColor.Color
                elseif ESP.TeamCheck then
                    espColor = isTeammate and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 0, 0)
                end
                
                if onScreen then
                    -- Hide off-screen arrow
                    objects.Arrow.Visible = false
                    
                    local boxHeight = 10
                    local boxWidth = 6
                    
                    -- Estimate box size dynamically depending on physical model availability
                    local head = char and char:FindFirstChild("Head")
                    if head and not isStreamedOut then
                        local headPos = camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
                        local footPos = camera:WorldToViewportPoint(positionToUse - Vector3.new(0, 3, 0))
                        boxHeight = math.clamp(math.abs(headPos.Y - footPos.Y), 6, 2000)
                        boxWidth = math.clamp(boxHeight * 0.6, 4, 1500)
                    else
                        -- Estimated size math for streamed-out targets
                        local sizeFactor = (5 / dist) * (viewportSize.Y / (2 * math.tan(math.rad(camera.FieldOfView) / 2)))
                        boxHeight = math.clamp(sizeFactor, 6, 2000)
                        boxWidth = math.clamp(boxHeight * 0.6, 4, 1500)
                    end
                    
                    -- Box Rendering (Normal vs Corner)
                    if ESP.Boxes then
                        if ESP.BoxStyle == "Corner" then
                            -- Hide normal box
                            objects.Box.Visible = false
                            objects.BoxOutline.Visible = false
                            
                            local x = pos.X - boxWidth / 2
                            local y = pos.Y - boxHeight / 2
                            
                            -- Left-Top Corner
                            objects.Corners[1].From = Vector2.new(x, y)
                            objects.Corners[1].To = Vector2.new(x + boxWidth / 4, y)
                            objects.Corners[1].Color = espColor
                            objects.Corners[1].Visible = true
                            
                            objects.Corners[2].From = Vector2.new(x, y)
                            objects.Corners[2].To = Vector2.new(x, y + boxHeight / 4)
                            objects.Corners[2].Color = espColor
                            objects.Corners[2].Visible = true
                            
                            -- Right-Top Corner
                            objects.Corners[3].From = Vector2.new(x + boxWidth, y)
                            objects.Corners[3].To = Vector2.new(x + boxWidth - boxWidth / 4, y)
                            objects.Corners[3].Color = espColor
                            objects.Corners[3].Visible = true
                            
                            objects.Corners[4].From = Vector2.new(x + boxWidth, y)
                            objects.Corners[4].To = Vector2.new(x + boxWidth, y + boxHeight / 4)
                            objects.Corners[4].Color = espColor
                            objects.Corners[4].Visible = true
                            
                            -- Left-Bottom Corner
                            objects.Corners[5].From = Vector2.new(x, y + boxHeight)
                            objects.Corners[5].To = Vector2.new(x + boxWidth / 4, y + boxHeight)
                            objects.Corners[5].Color = espColor
                            objects.Corners[5].Visible = true
                            
                            objects.Corners[6].From = Vector2.new(x, y + boxHeight)
                            objects.Corners[6].To = Vector2.new(x, y + boxHeight - boxHeight / 4)
                            objects.Corners[6].Color = espColor
                            objects.Corners[6].Visible = true
                            
                            -- Right-Bottom Corner
                            objects.Corners[7].From = Vector2.new(x + boxWidth, y + boxHeight)
                            objects.Corners[7].To = Vector2.new(x + boxWidth - boxWidth / 4, y + boxHeight)
                            objects.Corners[7].Color = espColor
                            objects.Corners[7].Visible = true
                            
                            objects.Corners[8].From = Vector2.new(x + boxWidth, y + boxHeight)
                            objects.Corners[8].To = Vector2.new(x + boxWidth, y + boxHeight - boxHeight / 4)
                            objects.Corners[8].Color = espColor
                            objects.Corners[8].Visible = true
                        else
                            -- Normal Box
                            for _, line in ipairs(objects.Corners) do
                                line.Visible = false
                            end
                            
                            if ESP.BoxOutline then
                                objects.BoxOutline.Size = Vector2.new(boxWidth, boxHeight)
                                objects.BoxOutline.Position = Vector2.new(pos.X - boxWidth / 2, pos.Y - boxHeight / 2)
                                objects.BoxOutline.Visible = true
                            else
                                objects.BoxOutline.Visible = false
                            end
                            
                            objects.Box.Size = Vector2.new(boxWidth, boxHeight)
                            objects.Box.Position = Vector2.new(pos.X - boxWidth / 2, pos.Y - boxHeight / 2)
                            objects.Box.Color = espColor
                            objects.Box.Visible = true
                        end
                    else
                        objects.Box.Visible = false
                        objects.BoxOutline.Visible = false
                        for _, line in ipairs(objects.Corners) do
                            line.Visible = false
                        end
                    end
                    
                    -- Health Bar Rendering
                    if ESP.HealthBar and not isStreamedOut then
                        local healthPercent = math.clamp(health / maxHealth, 0, 1)
                        local barColor = Color3.fromRGB(255, 0, 0):Lerp(Color3.fromRGB(0, 255, 0), healthPercent)
                        
                        local barWidth = 4
                        local barGap = 6
                        local barHeight = boxHeight
                        
                        local outlineX = pos.X - boxWidth / 2 - barWidth - barGap
                        local outlineY = pos.Y - boxHeight / 2
                        
                        objects.HealthOutline.Size = Vector2.new(barWidth + 2, barHeight + 2)
                        objects.HealthOutline.Position = Vector2.new(outlineX - 1, outlineY - 1)
                        objects.HealthOutline.Visible = true
                        
                        local fillHeight = barHeight * healthPercent
                        local fillY = outlineY + barHeight - fillHeight
                        
                        objects.HealthFill.Size = Vector2.new(barWidth, fillHeight)
                        objects.HealthFill.Position = Vector2.new(outlineX, fillY)
                        objects.HealthFill.Color = barColor
                        objects.HealthFill.Visible = true
                    else
                        objects.HealthOutline.Visible = false
                        objects.HealthFill.Visible = false
                    end
                    
                    -- NameTag Rendering with font scaling based on distance
                    if ESP.Names then
                        local label = player.Name
                        if isStreamedOut then
                            label = string.format("⏳ [LOST] %s [%dm]", player.Name, dist)
                        elseif ESP.Distance then
                            label = string.format("%s [%dm]", player.Name, dist)
                        end
                        
                        -- Scale text dynamically down to 9px at 1500+ studs
                        local textScale = math.clamp(math.floor(13 - (dist / 400)), 9, 13)
                        
                        objects.NameTag.Text = label
                        objects.NameTag.Size = textScale
                        objects.NameTag.Color = isStreamedOut and Color3.fromRGB(150, 150, 150) or (ESP.UseTeamColor and player.TeamColor and player.TeamColor.Color or ESP.NameColor)
                        objects.NameTag.Position = Vector2.new(pos.X, pos.Y - boxHeight / 2 - 15)
                        objects.NameTag.Visible = true
                    else
                        objects.NameTag.Visible = false
                    end
                    
                    -- Tracer Rendering
                    if ESP.Tracers then
                        local originX, originY = viewportSize.X / 2, viewportSize.Y
                        if ESP.TracerOrigin == "Top" then
                            originX, originY = viewportSize.X / 2, 0
                        elseif ESP.TracerOrigin == "Center" then
                            originX, originY = viewportSize.X / 2, viewportSize.Y / 2
                        end
                        
                        if ESP.TracerOutline then
                            objects.TracerOutline.From = Vector2.new(originX, originY)
                            objects.TracerOutline.To = Vector2.new(pos.X, pos.Y + boxHeight / 2)
                            objects.TracerOutline.Visible = true
                        else
                            objects.TracerOutline.Visible = false
                        end
                        
                        objects.Tracer.From = Vector2.new(originX, originY)
                        objects.Tracer.To = Vector2.new(pos.X, pos.Y + boxHeight / 2)
                        objects.Tracer.Color = isStreamedOut and Color3.fromRGB(120, 120, 120) or (ESP.UseTeamColor and player.TeamColor and player.TeamColor.Color or ESP.TracerColor)
                        objects.Tracer.Visible = true
                    else
                        objects.TracerOutline.Visible = false
                        objects.Tracer.Visible = false
                    end
                    
                    -- Head Dot Rendering
                    local head = char and char:FindFirstChild("Head")
                    if ESP.HeadDot and head and not isStreamedOut then
                        local headPos, onScreenHead = camera:WorldToViewportPoint(head.Position)
                        if onScreenHead then
                            local rad = math.clamp(120 / dist, 2, 8)
                            objects.HeadDot.Position = Vector2.new(headPos.X, headPos.Y)
                            objects.HeadDot.Radius = rad
                            objects.HeadDot.Color = ESP.UseTeamColor and player.TeamColor and player.TeamColor.Color or ESP.HeadDotColor
                            objects.HeadDot.Visible = true
                        else
                            objects.HeadDot.Visible = false
                        end
                    else
                        objects.HeadDot.Visible = false
                    end
                    
                    -- Look Tracer (Facing Line)
                    if ESP.LookTracers and head and not isStreamedOut then
                        local start3d = head.Position
                        local end3d = head.Position + (head.CFrame.LookVector * 15)
                        
                        local w2sStart, onScreenStart = camera:WorldToViewportPoint(start3d)
                        local w2sEnd, onScreenEnd = camera:WorldToViewportPoint(end3d)
                        
                        if onScreenStart and onScreenEnd then
                            objects.LookTracer.From = Vector2.new(w2sStart.X, w2sStart.Y)
                            objects.LookTracer.To = Vector2.new(w2sEnd.X, w2sEnd.Y)
                            objects.LookTracer.Color = ESP.UseTeamColor and player.TeamColor and player.TeamColor.Color or ESP.LookTracerColor
                            objects.LookTracer.Visible = true
                        else
                            objects.LookTracer.Visible = false
                        end
                    else
                        objects.LookTracer.Visible = false
                    end
                    
                    -- Equipped Weapon/Tool ESP
                    if ESP.Weapons and not isStreamedOut then
                        local weapon = char:FindFirstChildOfClass("Tool")
                        if weapon then
                            objects.WeaponTag.Text = string.upper(weapon.Name)
                            objects.WeaponTag.Color = ESP.UseTeamColor and player.TeamColor and player.TeamColor.Color or ESP.WeaponColor
                            objects.WeaponTag.Position = Vector2.new(pos.X, pos.Y + boxHeight / 2 + 5)
                            objects.WeaponTag.Visible = true
                        else
                            objects.WeaponTag.Visible = false
                        end
                    else
                        objects.WeaponTag.Visible = false
                    end
                    
                    -- Skeleton Rendering
                    if ESP.Skeletons and not isStreamedOut then
                        local boneIdx = 1
                        local isR15 = char:FindFirstChild("UpperTorso") ~= nil
                        local pairsList = isR15 and BonePairs.R15 or BonePairs.R6
                        
                        for _, pair in ipairs(pairsList) do
                            local p1 = char:FindFirstChild(pair[1])
                            local p2 = char:FindFirstChild(pair[2])
                            
                            if p1 and p2 then
                                local w2s1, onScreen1 = camera:WorldToViewportPoint(p1.Position)
                                local w2s2, onScreen2 = camera:WorldToViewportPoint(p2.Position)
                                
                                if onScreen1 and onScreen2 and boneIdx <= #objects.Bones then
                                    local line = objects.Bones[boneIdx]
                                    line.From = Vector2.new(w2s1.X, w2s1.Y)
                                    line.To = Vector2.new(w2s2.X, w2s2.Y)
                                    line.Color = ESP.UseTeamColor and player.TeamColor and player.TeamColor.Color or ESP.SkeletonColor
                                    line.Visible = true
                                    boneIdx = boneIdx + 1
                                end
                            end
                        end
                        
                        for i = boneIdx, #objects.Bones do
                            objects.Bones[i].Visible = false
                        end
                    else
                        for _, line in ipairs(objects.Bones) do
                            line.Visible = false
                        end
                    end
                    
                    -- Highlight Chams rendering
                    if ESP.Chams and not isStreamedOut then
                        local highlight = char:FindFirstChildOfClass("Highlight")
                        if not highlight then
                            highlight = Instance.new("Highlight")
                            highlight.Parent = char
                        end
                        highlight.Adornee = char
                        highlight.FillColor = ESP.UseTeamColor and player.TeamColor and player.TeamColor.Color or ESP.ChamsColor
                        highlight.OutlineColor = ESP.ChamsOutlineColor
                        highlight.FillTransparency = ESP.ChamsFillTrans
                        highlight.OutlineTransparency = ESP.ChamsOutlineTrans
                        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        highlight.Enabled = true
                        objects.Highlight = highlight
                    else
                        if char then
                            local highlight = char:FindFirstChildOfClass("Highlight")
                            if highlight then
                                pcall(function() highlight:Destroy() end)
                            end
                        end
                        objects.Highlight = nil
                    end
                else
                    -- Target is off-screen, hide on-screen elements
                    objects.Box.Visible = false
                    objects.BoxOutline.Visible = false
                    for _, line in ipairs(objects.Corners) do line.Visible = false end
                    objects.NameTag.Visible = false
                    objects.Tracer.Visible = false
                    if objects.TracerOutline then objects.TracerOutline.Visible = false end
                    objects.HealthOutline.Visible = false
                    objects.HealthFill.Visible = false
                    objects.HeadDot.Visible = false
                    for _, line in ipairs(objects.Bones) do line.Visible = false end
                    objects.LookTracer.Visible = false
                    objects.WeaponTag.Visible = false
                    if objects.Highlight then pcall(function() objects.Highlight.Enabled = false end) end
                    
                    -- Render Off-Screen Arrow if enabled
                    if ESP.OffScreenArrows then
                        local relativePos = camera.CFrame:PointToObjectSpace(positionToUse)
                        local angle = math.atan2(-relativePos.X, -relativePos.Z)
                        
                        local screenCenter = Vector2.new(viewportSize.X / 2, viewportSize.Y / 2)
                        local rotVec = Vector2.new(math.sin(angle), math.cos(angle))
                        local perpVec = Vector2.new(-rotVec.Y, rotVec.X)
                        
                        local arrowPos = screenCenter + rotVec * ESP.ArrowRadius
                        local pointA = arrowPos + rotVec * ESP.ArrowSize
                        local pointB = arrowPos - rotVec * (ESP.ArrowSize / 2) + perpVec * (ESP.ArrowSize / 1.5)
                        local pointC = arrowPos - rotVec * (ESP.ArrowSize / 2) - perpVec * (ESP.ArrowSize / 1.5)
                        
                        objects.Arrow.PointA = pointA
                        objects.Arrow.PointB = pointB
                        objects.Arrow.PointC = pointC
                        objects.Arrow.Color = isStreamedOut and Color3.fromRGB(120, 120, 120) or (ESP.UseTeamColor and player.TeamColor and player.TeamColor.Color or ESP.ArrowColor)
                        objects.Arrow.Visible = true
                    else
                        objects.Arrow.Visible = false
                    end
                end
            else
                hideESP(objects)
            end
        else
            hideESP(objects)
        end
    end
end)

