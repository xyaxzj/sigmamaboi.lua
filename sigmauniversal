function setFly(state)
    flying = state
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end
    
    if flying then
        hum.PlatformStand = true
        
        local camera = workspace.CurrentCamera
        local bodyVelocity = Instance.new("BodyVelocity")
        bodyVelocity.Velocity = Vector3.new(0, 0, 0)
        bodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
        bodyVelocity.Parent = hrp
        
        local bodyGyro = Instance.new("BodyGyro")
        bodyGyro.CFrame = hrp.CFrame
        bodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
        bodyGyro.Parent = hrp

        if mobileFlyGui then
            local container = mobileFlyGui:FindFirstChildOfClass("Frame")
            if container then
                for _, ch in ipairs(container:GetChildren()) do
                    if ch:IsA("TextButton") and ch.Text:find("Fly O") then
                        ch.Text = "Fly ON"
                        ch.BackgroundColor3 = Color3.fromRGB(50, 180, 100)
                    end
                end
            end
        end

        flyConnection = RunService.RenderStepped:Connect(function()
            local direction = Vector3.new(0, 0, 0)
            local moveDirection = hum.MoveDirection
            if moveDirection.Magnitude > 0 then
                direction = direction + moveDirection
            end
            
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) or flyUp then
                direction = direction + Vector3.new(0, 1, 0)
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or flyDown then
                direction = direction - Vector3.new(0, 1, 0)
            end
            
            local targetVelocity = Vector3.new(0, 0, 0)
            targetVelocity = targetVelocity + hum.MoveDirection * flySpeed
            
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) or flyUp then
                targetVelocity = targetVelocity + Vector3.new(0, flySpeed, 0)
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or flyDown then
                targetVelocity = targetVelocity - Vector3.new(0, flySpeed, 0)
            end
            
            bodyVelocity.Velocity = targetVelocity
            
            local look = camera.CFrame.LookVector
            bodyGyro.CFrame = CFrame.new(hrp.Position, hrp.Position + Vector3.new(look.X, 0, look.Z))
        end)
    else
        hum.PlatformStand = false
        if hrp:FindFirstChild("BodyVelocity") then hrp.BodyVelocity:Destroy() end
        if hrp:FindFirstChild("BodyGyro") then hrp.BodyGyro:Destroy() end
        if flyConnection then
            flyConnection:Disconnect()
            flyConnection = nil
        end
        if mobileFlyGui then
            local container = mobileFlyGui:FindFirstChildOfClass("Frame")
            if container then
                for _, ch in ipairs(container:GetChildren()) do
                    if ch:IsA("TextButton") and ch.Text:find("Fly O") then
                        ch.Text = "Fly OFF"
                        ch.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
                    end
                end
            end
        end
    end
end

-- ===========================================================================
--  NOCLIP & CLICK TP & ANTI-AFK
-- ===========================================================================
local function setNoclip(state)
    noclipEnabled = state
    if noclipEnabled then
        if not noclipConnection then
            noclipConnection = RunService.Stepped:Connect(function()
                if noclipEnabled and LocalPlayer.Character then
                    for _, part in ipairs(LocalPlayer.Character:GetChildren()) do
                        if part:IsA("BasePart") then
                            part.CanCollide = false
                        end
                    end
                end
            end)
        end
    else
        if noclipConnection then
            noclipConnection:Disconnect()
            noclipConnection = nil
        end
    end
end

local function setClickTp(state)
    clickTpEnabled = state
    if clickTpEnabled then
        if not clickTpConnection then
            clickTpConnection = UserInputService.InputBegan:Connect(function(input, processed)
                if processed then return end
                if clickTpEnabled and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
                    local mouse = LocalPlayer:GetMouse()
                    local targetPos = mouse.Hit.Position
                    local char = LocalPlayer.Character
                    local hrp = char and char:FindFirstChild("HumanoidRootPart")
                    if hrp then
                        hrp.CFrame = CFrame.new(targetPos + Vector3.new(0, 3, 0))
                    end
                end
            end)
        end
    else
        if clickTpConnection then
            clickTpConnection:Disconnect()
            clickTpConnection = nil
        end
    end
end

local function toggleAntiAfk(state)
    antiAfkEnabled = state
    if state then
        if not antiAfkConnection then
            antiAfkConnection = LocalPlayer.Idled:Connect(function()
                if antiAfkEnabled then
                    VirtualUser:CaptureController()
                    VirtualUser:ClickButton2(Vector2.new(0,0))
                end
            end)
        end
    else
        if antiAfkConnection then
            antiAfkConnection:Disconnect()
            antiAfkConnection = nil
        end
    end
end

-- ===========================================================================
--  COORDINATE MANAGER
-- ===========================================================================
local function refreshCoordsDropdown()
    if savedCoordsDropdown then
        local opts = {}
        for k, _ in pairs(SavedCoords) do
            table.insert(opts, k)
        end
        table.sort(opts)
        savedCoordsDropdown:Refresh(opts)
    end
end

local function saveCoord(name)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    local cframe = hrp.CFrame
    SavedCoords[name] = cframe
    
    refreshCoordsDropdown()
    Library:Notify({Title = "Location Saved", Content = "Saved: " .. name, Type = "Success", Duration = 2})
end

local function deleteCoord(name)
    if not name then return end
    SavedCoords[name] = nil
    
    refreshCoordsDropdown()
    Library:Notify({Title = "Location Deleted", Content = "Deleted: " .. name, Type = "Info", Duration = 2})
end

local function teleportToSaved(name)
    if not name or not SavedCoords[name] then return end
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.CFrame = SavedCoords[name]
        Library:Notify({Title = "Teleported", Content = "Teleported to " .. name, Type = "Success", Duration = 2})
    end
end

local function copyCoords()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    local pos = hrp.Position
    local cf = hrp.CFrame
    local str = string.format("CFrame.new(%f, %f, %f, %f, %f, %f, %f, %f, %f, %f, %f, %f)", cf:GetComponents())
    if setclipboard or toclipboard then
        local set = setclipboard or toclipboard
        set(str)
        Library:Notify({Title = "Copied", Content = "Coordinates copied to clipboard!", Type = "Success", Duration = 2})
    else
        Library:Notify({Title = "Error", Content = "Clipboard function not supported by executor.", Type = "Error", Duration = 3})
    end
end

-- ===========================================================================
--  PLAYER ESP SYSTEM
-- ===========================================================================
local ESP = {
    Enabled = false,
    Boxes = true,
    Names = true,
    Tracers = false,
    Distance = true,
    Players = {},
}

local function createESP(player)
    if player == LocalPlayer then return end
    
    local espObjects = {}
    
    local box = Drawing.new("Square")
    box.Visible = false
    box.Color = Color3.fromRGB(0, 255, 140)
    box.Thickness = 1.5
    box.Filled = false
    espObjects.Box = box
    
    local nameTag = Drawing.new("Text")
    nameTag.Visible = false
    nameTag.Color = Color3.fromRGB(240, 240, 240)
    nameTag.Size = 13
    nameTag.Center = true
    nameTag.Outline = true
    nameTag.Font = 2
    espObjects.NameTag = nameTag
    
    local tracer = Drawing.new("Line")
    tracer.Visible = false
    tracer.Color = Color3.fromRGB(255, 255, 255)
    tracer.Thickness = 1
    espObjects.Tracer = tracer
    
    ESP.Players[player] = espObjects
end

local function removeESP(player)
    local espObjects = ESP.Players[player]
    if espObjects then
        pcall(function() espObjects.Box:Destroy() end)
        pcall(function() espObjects.NameTag:Destroy() end)
        pcall(function() espObjects.Tracer:Destroy() end)
        ESP.Players[player] = nil
    end
end

RunService.RenderStepped:Connect(function()
    if not ESP.Enabled then
        for _, objects in pairs(ESP.Players) do
            objects.Box.Visible = false
            objects.NameTag.Visible = false
            objects.Tracer.Visible = false
        end
        return
    end
    
    local camera = workspace.CurrentCamera
    local viewportSize = camera.ViewportSize
    
    for player, objects in pairs(ESP.Players) do
        local char = player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        
        if hrp and hum and hum.Health > 0 then
            local pos, onScreen = camera:WorldToViewportPoint(hrp.Position)
            
            if onScreen then
                local head = char:FindFirstChild("Head")
                local headPos = head and camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0)) or pos
                local footPos = camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
                
                local boxHeight = math.abs(headPos.Y - footPos.Y)
                local boxWidth = boxHeight * 0.6
                
                if ESP.Boxes then
                    objects.Box.Size = Vector2.new(boxWidth, boxHeight)
                    objects.Box.Position = Vector2.new(pos.X - boxWidth / 2, pos.Y - boxHeight / 2)
                    objects.Box.Visible = true
                else
                    objects.Box.Visible = false
                end
                
                if ESP.Names then
                    local label = player.Name
                    if ESP.Distance then
                        local dist = math.floor((hrp.Position - camera.CFrame.Position).Magnitude)
                        label = string.format("%s [%dm]", player.Name, dist)
                    end
                    objects.NameTag.Text = label
                    objects.NameTag.Position = Vector2.new(pos.X, pos.Y - boxHeight / 2 - 15)
                    objects.NameTag.Visible = true
                else
                    objects.NameTag.Visible = false
                end
                
                if ESP.Tracers then
                    objects.Tracer.From = Vector2.new(viewportSize.X / 2, viewportSize.Y)
                    objects.Tracer.To = Vector2.new(pos.X, pos.Y + boxHeight / 2)
                    objects.Tracer.Visible = true
                else
                    objects.Tracer.Visible = false
                end
            else
                objects.Box.Visible = false
                objects.NameTag.Visible = false
                objects.Tracer.Visible = false
            end
        else
            objects.Box.Visible = false
            objects.NameTag.Visible = false
            objects.Tracer.Visible = false
        end
    end
end)

for _, p in ipairs(Players:GetPlayers()) do createESP(p) end
Players.PlayerAdded:Connect(createESP)
Players.PlayerRemoving:Connect(removeESP)

