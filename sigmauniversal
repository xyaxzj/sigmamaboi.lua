-- Deteksi senjata yang lebih kuat
local function getActiveWeapon(char)
    local tool = char:FindFirstChildOfClass("Tool")
    if tool then return tool end
    
    local ignoreList = {
        HumanoidRootPart=true, Head=true, UpperTorso=true, LowerTorso=true, Torso=true,
        RightArm=true, LeftArm=true, RightLeg=true, LeftLeg=true,
        RightUpperArm=true, RightLowerArm=true, RightHand=true,
        LeftUpperArm=true, LeftLowerArm=true, LeftHand=true,
        RightUpperLeg=true, RightLowerLeg=true, RightFoot=true,
        LeftUpperLeg=true, LeftLowerLeg=true, LeftFoot=true,
        Humanoid=true, ForceField=true, Shirt=true, Pants=true, ShirtGraphic=true, BodyColors=true,
        Animate=true, Health=true
    }
    
    for _, child in ipairs(char:GetChildren()) do
        if (child:IsA("Model") or child:IsA("Folder") or child:IsA("Tool")) and not ignoreList[child.Name] and not child:IsA("Accessory") then
            return child 
        end
    end
    return nil
end

-- Loop menggunakan Heartbeat (Berjalan sesuai FPS, max performa)
local lastShotTime = 0
RunService.Heartbeat:Connect(function()
    if not autoShootEnabled or not shootRemote then return end
    
    local currentTime = tick()
    if currentTime - lastShotTime < autoShootDelay then return end

    local localChar = LocalPlayer.Character
    local localHrp = localChar and localChar:FindFirstChild("HumanoidRootPart")
    if not localHrp then return end

    local weapon = getActiveWeapon(localChar)
    if not weapon then return end -- Hanya nembak kalau pegang senjata

    -- Cari musuh terdekat setiap frame
    local closestTarget = nil
    local shortestDist = math.huge
    
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            if autoShootTeamCheck and p.Team == LocalPlayer.Team then continue end
            
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            
            if hrp and hum and hum.Health > 0 then
                local dist = (hrp.Position - localHrp.Position).Magnitude
                if dist < shortestDist then
                    shortestDist = dist
                    closestTarget = p
                end
            end
        end
    end

    if closestTarget then
        local targetChar = closestTarget.Character
        local targetHrp = targetChar:FindFirstChild("HumanoidRootPart")
        local targetHum = targetChar:FindFirstChildOfClass("Humanoid")
        
        if targetHrp and targetHum then
            local targetPos = targetHrp.Position
            
            -- VELOCITY PREDICTION: Kompensasi saat musuh lari/loncat
            if enablePrediction then
                local distToTarget = (targetPos - localHrp.Position).Magnitude
                local predictionTime = distToTarget / bulletSpeed 
                -- AssemblyLinearVelocity menghitung arah & kecepatan fisik (termasuk loncat di sumbu Y)
                targetPos = targetPos + (targetHrp.AssemblyLinearVelocity * predictionTime)
            end
            
            -- Set Aimbot memutar peluru langsung ke lokasi yang sudah di-prediksi
            local aimCFrame = CFrame.lookAt(localHrp.Position, targetPos)
            
            local args = {
                [1] = tick(),
                [2] = weapon,
                [3] = aimCFrame,
                [4] = { ["1"] = targetHum }
            }
            
            shootRemote:FireServer(table.unpack(args))
            lastShotTime = currentTime
        end
    end
end)

