local function refreshCoordsDropdown()
    if savedCoordsDropdown then
        local opts = {}
        for k, _ in pairs(SavedCoords) do
            table.insert(opts, k)
        end
        table.sort(opts)
        savedCoordsDropdown:Refresh(opts)
    end
end

local function saveCoord(name)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    local cframe = hrp.CFrame
    SavedCoords[name] = cframe
    
    refreshCoordsDropdown()
    Library:Notify({Title = "Location Saved", Content = "Saved: " .. name, Type = "Success", Duration = 2})
end

local function deleteCoord(name)
    if not name then return end
    SavedCoords[name] = nil
    
    refreshCoordsDropdown()
    Library:Notify({Title = "Location Deleted", Content = "Deleted: " .. name, Type = "Info", Duration = 2})
end

local function teleportToSaved(name)
    if not name or not SavedCoords[name] then return end
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.CFrame = SavedCoords[name]
        Library:Notify({Title = "Teleported", Content = "Teleported to " .. name, Type = "Success", Duration = 2})
    end
end

local function copyCoords()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    local pos = hrp.Position
    local cf = hrp.CFrame
    local str = string.format("CFrame.new(%f, %f, %f, %f, %f, %f, %f, %f, %f, %f, %f, %f)", cf:GetComponents())
    if setclipboard or toclipboard then
        local set = setclipboard or toclipboard
        set(str)
        Library:Notify({Title = "Copied", Content = "Coordinates copied to clipboard!", Type = "Success", Duration = 2})
    else
        Library:Notify({Title = "Error", Content = "Clipboard function not supported by executor.", Type = "Error", Duration = 3})
    end
end

